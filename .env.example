NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Retries alternate with this model when GEMINI_MODEL is busy, out of quota or slow. Same as GEMINI_MODEL turns it off.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Public test mode: sample reports, visitors may try the staff role, reports deleted after 3 days.
AMANAH_SANDBOX=
# Long random value; Vercel Cron sends it to /api/sandbox/cleanup.
CRON_SECRET=

# Development only (ignored by builds and production):
# AMANAH_FIXTURES=1               # in-memory data and a fake Gemini; `npm run dev:fixtures` sets it
# AMANAH_FIXTURES_GEMINI_BUSY=1   # with fixtures: Gemini always answers "busy", to try the fallbacks
# AMANAH_MONITORING_DEMO=1        # synthetic data on /admin?section=monitoring
